 		}
 	}
-#endif /* NO_PF */
+#endif
+
+	/* FUZZ: drive pftable_handler from stdin via libmsg_generator.
+	 * One compartment, five real pf_cmd types ('A' add, 'C' change,
+	 * 'L' lease, 'R' rebind, 'K' kill).  After stdin is exhausted one
+	 * EOM (cmd.type = 'G') is dispatched; pftable_handler's 'G' case
+	 * calls eom_counter_inc() so the library exits cleanly. */
+	if (pipe(pfpipe) == -1)
+		fatal("pipe");
+
+	{
+		struct msg_interface	 iface;
+		struct msg_data		 msg;
+		struct msg_data		 eom_msg;
+		const char		 valid_types[] = {'A', 'C', 'L', 'R', 'K'};
+
+		if (msg_interface_init(&iface, STDIN_FILENO, 1,
+		    sizeof(valid_types)) != MSG_GEN_SUCCESS)
+			fatalx("msg_interface_init failed");
+		msg_interface_set_endpoint(&iface, 0,
+		    (void *)(intptr_t)pfpipe[1]);
+		msg_interface_set_eom_type(&iface, 'G');
+
+		while (msg_generate(&iface, &msg) == MSG_GEN_SUCCESS) {
+			if (msg.actual_payload_size < sizeof(struct pf_cmd))
+				continue;
+			((struct pf_cmd *)msg.payload)->type =
+			    valid_types[msg.type];
+			atomicio(vwrite, pfpipe[1], msg.payload,
+			    sizeof(struct pf_cmd));
+		}
+
+		if (msg_generate_eom(&iface, 0, &eom_msg) == MSG_GEN_SUCCESS) {
+			struct pf_cmd	cmd;
+			cmd.type = (char)eom_msg.type;
+			atomicio(vwrite, pfpipe[1], &cmd,
+			    sizeof(struct pf_cmd));
+		}
+	}
+
+	pftable_handler();
+	/* NOTREACHED — pftable_handler's 'G' case calls eom_counter_inc()
+	 * which exits the process once the EOM has been received. */
+
 
 	if (udpsockmode)
 		udpsock_startup(udpaddr);
