++	    fuzz_constraint_pipe) == -1)
++		fatal("socketpair for fuzzing");
++	imsg_init(&other_constraint, fuzz_constraint_pipe[1]);
++
++	{
++		struct msg_interface iface;
++		struct msg_data msg;
++
++		if (msg_interface_init(&iface, STDIN_FILENO, 2, IMSG_EOM)
