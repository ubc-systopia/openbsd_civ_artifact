++	/*
++	 * Fuzzing harness: drive both compartments (the ntp child and a
++	 * synthetic constraint endpoint) from stdin via libmsg_generator.
++	 * Two compartments (compartment 0 = ntp child via pipe_chld,
++	 * compartment 1 = the synthesised constraint endpoint), 20 valid
++	 * message types (IMSG_NONE..IMSG_PROBE_ROOT = 0..19) — IMSG_EOM
++	 * (20) is reserved as the end-of-input marker.  msg_interface_init
++	 * automatically sets the expected EOM count to num_compartments,
++	 * so the receivers exit(0) once one EOM per compartment has been
++	 * dispatched.
++	 */
++	struct imsgbuf other_side;
++	struct imsgbuf other_constraint;
++	int fuzz_constraint_pipe[2];
++
++	imsg_init(&other_side, pipe_chld[1]);
