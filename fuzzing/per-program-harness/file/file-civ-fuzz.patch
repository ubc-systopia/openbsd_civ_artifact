 	}
 	close(pair[1]);
+#endif
 
 	if (pledge("stdio rpath sendfd", NULL) == -1)
 		err(1, "pledge");
@@ -225,9 +256,30 @@ main(int argc, char **argv)
 		goto wait_for_child;
 
 	imsg_init(&ibuf, pair[0]);
+#ifdef FILE_PRIV_ONLY
+	idx = 0;
+	while (msg_generate(&iface, &fuzz_msg) == MSG_GEN_SUCCESS) {
+		fd = prepare_message(&msg, idx, "/dev/null");
+		send_message(&ibuf, &msg, sizeof msg, fd);
+
+		if (fuzz_msg.fd != -1) {
+			close(fuzz_msg.fd);
+			fuzz_msg.fd = -1;
+		}
+		if (fuzz_msg.payload != NULL &&
