+			err(1, "imsg_flush");
+#else
 	for (idx = 0; idx < argc; idx++) {
 		fd = prepare_message(&msg, idx, argv[idx]);
 		send_message(&ibuf, &msg, sizeof msg, fd);
+#endif
 
 		if (read_message(&ibuf, &imsg, pid) == 0)
 			break;
@@ -237,15 +289,26 @@ main(int argc, char **argv)
 		if (ack->idx != idx)
 			errx(1, "index not expected");
 		imsg_free(&imsg);
+#ifdef FILE_PRIV_ONLY
+		idx++;
+#endif
 	}
 
 wait_for_child:
+#ifdef FILE_PRIV_ONLY
+	imsg_clear(&ibuf);
+	imsg_clear(&fuzz_ibuf);
+	close(pair[0]);
+	close(pair[1]);
+	return (0);
+#else
 	close(pair[0]);
 	while (wait(NULL) == -1 && errno != ECHILD) {
 		if (errno != EINTR)
 			err(1, "wait");
 	}
 	_exit(0); /* let the child flush */
+#endif
 }
 
