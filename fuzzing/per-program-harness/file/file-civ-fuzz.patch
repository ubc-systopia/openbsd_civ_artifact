 	parent = getpid();
 	if (socketpair(AF_UNIX, SOCK_STREAM, PF_UNSPEC, pair) != 0)
 		err(1, "socketpair");
+#ifdef FILE_PRIV_ONLY
+	pid = parent;
+	imsg_init(&fuzz_ibuf, pair[1]);
+	if (msg_interface_init(&iface, STDIN_FILENO, 1, 2) !=
+	    MSG_GEN_SUCCESS)
+		errx(1, "msg_interface_init");
