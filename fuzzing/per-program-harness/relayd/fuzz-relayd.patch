+# BEGIN harness
+# Pull in libmsg_generator.a (structured stdin input) and libbuffer_check.so
+# (runtime pointer-leak detector) from ptr_checker.  BUFFER_CHECKER_ROOT must
+# point at the built ptr_checker directory.  -fsanitize-recover=memory keeps
+# MSan from aborting on the first uninit hit so AFL can keep making progress.
+#
+# Upstream relayd privsep is fork(2)+execvp(2) across four compartments
+# (PFE/HCE/RELAY/CA), so libbuffer_check.so is meaningful here: pointer-shaped
+# values the parent emits over the imsg sockets would be invalid in the
+# child's address space in production.  For the sanity check / productive AFL
+# pass, build ptr_checker with ENABLE_PTR_CHECK=0 so check_buffer() is a no-op
+# interceptor.  For the cross-compartment leak inspection pass, rebuild with
+# ENABLE_PTR_CHECK=1; relayd's startup config-distribution (e.g.
+# proc_compose_imsg(IMSG_CTL_PROCFD, ...)) will trip the detector on every
+# test case — see README.md for the inspection-pass workflow.
+BUFFER_CHECKER_ROOT?=	${.CURDIR}/../../../ptr_checker
+CFLAGS+=		-I${BUFFER_CHECKER_ROOT}
+CFLAGS+=		-fsanitize-recover=memory
+LDADD+=			${BUFFER_CHECKER_ROOT}/libmsg_generator.a
+LDADD+=			-L${BUFFER_CHECKER_ROOT} -lbuffer_check
+# END harness
 
 .include <bsd.prog.mk>
