diff -ruN -x .git tmux-orig/proc.c fuzz-tmux/proc.c
--- tmux-orig/proc.c	2026-04-30 15:51:25.727915000 -0700
+++ fuzz-tmux/proc.c	2026-04-30 15:52:36.998360000 -0700
@@ -356,27 +356,20 @@
 }
 
 pid_t
-proc_fork_and_daemon(int *fd)
+proc_fork_and_daemon(int *fd, int *other_side)
 {
-	pid_t	pid;
 	int	pair[2];
 
+	/*
+	 * Fuzzing harness: do not fork. Return both ends of the socketpair so
+	 * the caller can drive the server's imsg endpoint from the same
+	 * process.
+	 */
 	if (socketpair(AF_UNIX, SOCK_STREAM, PF_UNSPEC, pair) != 0)
 		fatal("socketpair failed");
-	switch (pid = fork()) {
-	case -1:
-		fatal("fork failed");
-	case 0:
-		close(pair[0]);
-		*fd = pair[1];
-		if (daemon(1, 0) != 0)
-			fatal("daemon failed");
-		return (0);
-	default:
-		close(pair[1]);
-		*fd = pair[0];
-		return (pid);
-	}
+	*fd = pair[0];
+	*other_side = pair[1];
+	return (0);
 }
 
 uid_t
