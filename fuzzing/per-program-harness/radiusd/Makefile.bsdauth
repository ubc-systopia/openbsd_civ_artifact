CC ?= cc
BUFFER_CHECKER_ROOT ?= ${.CURDIR}/ptr_checker
PROG= radiusd-bsdauth-priv-harness
SRCS= radiusd_bsdauth.c compat/bsd_auth.c
OBJS= radiusd_bsdauth.helper.o compat/bsd_auth.helper.o
IMSG_OBJS= lib/libutil/imsg.bsdauth.pic.o lib/libutil/imsg-buffer.bsdauth.pic.o
IMSG_LIB= libprivimsg-bsdauth.so
CFLAGS+= -Wall -I${.CURDIR} -Icompat -Ilib/libutil \
	-I${BUFFER_CHECKER_ROOT} -I/usr/local/include
CFLAGS+= -include compat/openbsd-compat.h -DRADIUSD_BSDAUTH_PRIV_ONLY
CFLAGS+= -ffunction-sections -fdata-sections -g
LDFLAGS+= -Wl,--gc-sections -L${BUFFER_CHECKER_ROOT} -L${.CURDIR}
LDFLAGS+= -Wl,-rpath,'$$ORIGIN' -Wl,-rpath,'$$ORIGIN/ptr_checker'
LDADD+= ${BUFFER_CHECKER_ROOT}/libmsg_generator.a
LDADD+= -lbuffer_check -lprivimsg-bsdauth -lprocstat -lmd -lcrypt
CHECKS ?= none
.if "$(CHECKS)" == "msan"
CFLAGS+= -fsanitize=memory -fsanitize-recover=memory
LDFLAGS+= -fsanitize=memory
.endif
all: $(IMSG_LIB) $(PROG)
radiusd_bsdauth.helper.o: radiusd_bsdauth.c
	$(CC) $(CFLAGS) -c -o $@ radiusd_bsdauth.c
compat/bsd_auth.helper.o: compat/bsd_auth.c
	$(CC) $(CFLAGS) -c -o $@ compat/bsd_auth.c
lib/libutil/imsg.bsdauth.pic.o: lib/libutil/imsg.c
	$(CC) $(CFLAGS) -fPIC -c -o $@ lib/libutil/imsg.c
lib/libutil/imsg-buffer.bsdauth.pic.o: lib/libutil/imsg-buffer.c
	$(CC) $(CFLAGS) -fPIC -c -o $@ lib/libutil/imsg-buffer.c
$(IMSG_LIB): $(IMSG_OBJS)
	$(CC) $(LDFLAGS) -shared -o $@ $(IMSG_OBJS)
$(PROG): $(OBJS) $(IMSG_LIB)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LDADD)
clean:
	rm -f $(PROG) $(OBJS) $(IMSG_OBJS) $(IMSG_LIB)
.PHONY: all clean
