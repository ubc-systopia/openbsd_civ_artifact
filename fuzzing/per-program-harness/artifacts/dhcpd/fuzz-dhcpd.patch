+		counter++;
+
+		/* Extract auxiliary data - first 4 bytes can be msg_id */
+		uint32_t msg_id = *(uint32_t *)&msg.aux_data[0];
+
+		/* Prepare payload with proper size for pf_cmd */
+		size_t send_size = sizeof(struct pf_cmd);
+
+		/* Set the type field in the pf_cmd structure */
+		if (msg.actual_payload_size >= sizeof(struct pf_cmd)) {
+			((struct pf_cmd *)msg.payload)->type = valid_types[msg.type];
+		}
+
+		printf("Fuzzing: sending msg_type=%d, size=%zu, id=%u to pftable_handler\n",
+		       msg.type, send_size, msg_id);
+
+		/* Write to pfpipe[1] */
+		atomicio(vwrite, pfpipe[1], msg.payload, send_size);
+	}
