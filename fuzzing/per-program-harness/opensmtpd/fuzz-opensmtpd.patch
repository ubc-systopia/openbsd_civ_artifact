@@ -1143,8 +1142,9 @@
 	if (pidfile(NULL) < 0)
 		err(1, "pidfile");
 
-	fork_filter_processes();
+	// fork_filter_processes(); // ??? should we comment this out?
 
+
 	purge_task();
 
 #if HAVE_PLEDGE
@@ -1152,6 +1152,61 @@
 	    "getpw sendfd proc exec id inet chown unix", NULL) == -1)
 		fatal("pledge");
 #endif
+
+	struct imsgbuf lka_buf, queue_buf, control_buf, scheduler_buf, dispatcher_buf, ca_buf;
+
+	if (p_lka)
+		imsgbuf_init(&lka_buf, p_lka->other_fd);
+	if (p_queue)
+		imsgbuf_init(&queue_buf, p_queue->other_fd);
+	if (p_control)
+		imsgbuf_init(&control_buf, p_control->other_fd);
+	if (p_scheduler)
+		imsgbuf_init(&scheduler_buf, p_scheduler->other_fd);
+	if (p_dispatcher)
+		imsgbuf_init(&dispatcher_buf, p_dispatcher->other_fd);
+	if (p_ca)
+		imsgbuf_init(&ca_buf, p_ca->other_fd);
+
+	struct msg_interface iface;
+	if (msg_interface_init(&iface, STDIN_FILENO, 6, IMSG_EOM) != MSG_GEN_SUCCESS)
+		fatalx("msg_interface_init failed");
+
+	msg_interface_set_endpoint(&iface, 0, &lka_buf);
+	msg_interface_set_endpoint(&iface, 1, &queue_buf);
+	msg_interface_set_endpoint(&iface, 2, &control_buf);
+	msg_interface_set_endpoint(&iface, 3, &scheduler_buf);
+	msg_interface_set_endpoint(&iface, 4, &dispatcher_buf);
+	msg_interface_set_endpoint(&iface, 5, &ca_buf);
+
+	msg_interface_set_eom_type(&iface, IMSG_EOM);
+
+	/* Scheduler does not dispatch IMSG_EOM, so expect EOMs from 5 endpoints. */
+	eom_counter_init(5);
+
+	struct msg_data msg;
+	while (msg_generate(&iface, &msg) == MSG_GEN_SUCCESS) {
+		struct imsgbuf *target = (struct imsgbuf *)msg.endpoint;
+		uint32_t peerid = *(uint32_t *)&msg.aux_data[0];
+		uint32_t pid = *(uint32_t *)&msg.aux_data[4];
+
+		ptr_check_skip(msg.payload, msg.actual_payload_size);
+		imsg_compose(target, msg.type, peerid, pid,
+		    msg.has_fd ? msg.fd : -1,
+		    msg.payload, msg.actual_payload_size);
+		imsgbuf_flush(target);
+	}
+
+	for (uint8_t i = 0; i < iface.num_compartments; i++) {
+		if (i == 3) /* skip scheduler */
+			continue;
+		struct msg_data eom_msg;
+		if (msg_generate_eom(&iface, i, &eom_msg) == MSG_GEN_SUCCESS) {
+			struct imsgbuf *target = (struct imsgbuf *)eom_msg.endpoint;
+			imsg_compose(target, eom_msg.type, 0, 0, -1, NULL, 0);
+			imsgbuf_flush(target);
+		}
+	}
 
 	event_dispatch();
 	fatalx("exited event loop");
