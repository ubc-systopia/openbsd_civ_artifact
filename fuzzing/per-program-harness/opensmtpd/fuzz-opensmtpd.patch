-	case 0:
-		break;
-	default:
-		close(sp[0]);
+	/*
+	 * Harness: do not fork.  The parent keeps sp[0] (handed back via
+	 * mproc.other_fd) so the fuzzer can write imsgs into the child's
+	 * receive end.  All compartments end up running in the parent,
+	 * which is what makes single-process fuzzing tractable.
+	 */
+	(void)pid;
+	(void)save_argc;
+	{
+		static int mypid = 1234;
 		p = calloc(1, sizeof(*p));
 		if (p == NULL)
 			fatal("calloc");
-		if((p->name = strdup(rexec)) == NULL)
+		if ((p->name = strdup(rexec)) == NULL)
 			fatal("strdup");
 		mproc_init(p, sp[1]);
-		p->pid = pid;
+		p->pid = mypid++;
+		p->other_fd = sp[0];
 		p->handler = parent_imsg;
 		return p;
 	}
 
-	if (sp[0] != 3) {
-		if (dup2(sp[0], 3) == -1)
-			fatal("%s: dup2", rexec);
-	} else if (fcntl(sp[0], F_SETFD, 0) == -1)
-		fatal("%s: fcntl", rexec);
-
-	xclosefrom(4);
-
-	for (argc = 0; argc < save_argc; argc++)
-		argv[argc] = save_argv[argc];
-	argv[argc++] = "-x";
-	argv[argc++] = rexec;
-	argv[argc++] = NULL;
-
-	execvp(argv[0], argv);
-	fatal("%s: execvp", rexec);
+	(void)argv;
+	(void)argc;
+	return NULL;
 }
 
