# ---------------------------------------------------------------------------
# OpenClaw installer settings.  The ONLY required edit is the API key below.
# ---------------------------------------------------------------------------

# Your Anthropic API key (https://console.anthropic.com/settings/keys).
# Paste it between the quotes.  It starts with "sk-ant-".
ANTHROPIC_API_KEY=""

# Optional. Model OpenClaw talks to (OpenClaw "provider/model" id).
#OPENCLAW_MODEL="anthropic/claude-sonnet-4-6"

# Optional. Folder the agent works in (created if missing): its cwd for
# commands and where it keeps its own notes/memory files.  Drop files here for
# it to work on.
#OPENCLAW_WORKSPACE="$HOME/openclaw-workspace"

# Optional. "false" (default): the agent's file tools may read/write anywhere
# this user can, and shell commands run as this user.  "true": file tools are
# confined to the workspace folder (shell commands are still unrestricted).
#OPENCLAW_WORKSPACE_ONLY="false"

# Optional. Where the Gateway (Control UI + API) listens.
#   loopback  only reachable from inside this machine (default, safest;
#             from another machine use: ssh -L 18789:127.0.0.1:18789 user@host)
#   lan       reachable from other machines on the local network
#OPENCLAW_GATEWAY_BIND="loopback"
